{
  "name": "chem-agent-workbench",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write src tests vite.config.ts eslint.config.js tsconfig.json package.json index.html",
    "format:check": "prettier --check src tests vite.config.ts eslint.config.js tsconfig.json package.json index.html"
  },
  "dependencies": {
    "@lucide/vue": "1.50.0",
    "vue": "3.5.43"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.18.6",
    "@vitejs/plugin-vue": "6.0.9",
    "eslint": "10.12.0",
    "eslint-plugin-vue": "10.11.1",
    "prettier": "3.9.9",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.2",
    "vitest": "5.0.3",
    "vue-tsc": "3.3.12"
  }
}
